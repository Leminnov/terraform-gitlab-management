{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":preserveSemverRanges",
    ":dependencyDashboard",
    "security:openssf-scorecard"
  ],
  "timezone": "Europe/Paris",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "dependencies",
    "renovate"
  ],
  "rangeStrategy": "bump",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "vulnerabilityAlerts": {
    "labels": [
      "security"
    ],
    "enabled": true,
    "schedule": [
      "at any time"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 6am on monday"
    ]
  },
  "packageRules": [
    {
      "description": "One PR for the toolchain: mise.toml pins and their copies in .gitlab/ (images and the `# renovate:` variables) must change in the same commit",
      "matchManagers": [
        "mise",
        "gitlabci",
        "custom.regex"
      ],
      "groupName": "toolchain"
    },
    {
      "description": "Group all Terraform provider bumps",
      "matchManagers": [
        "terraform"
      ],
      "matchDepTypes": [
        "required_provider"
      ],
      "groupName": "terraform providers"
    },
    {
      "description": "Group pre-commit hook bumps",
      "matchManagers": [
        "pre-commit"
      ],
      "groupName": "pre-commit hooks"
    },
    {
      "description": "Automerge patch-level bumps for dev tooling",
      "matchManagers": [
        "mise",
        "pre-commit",
        "gitlabci",
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "automergeType": "branch"
    },
    {
      "description": "Never automerge the GitLab provider — infra blast radius",
      "matchPackageNames": [
        "gitlabhq/gitlab"
      ],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions in .gitlab/global.yml annotated with a `# renovate:` comment",
      "managerFilePatterns": [
        "/^\\.gitlab/global\\.yml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( extractVersion=(?<extractVersion>\\S+))?\\n\\s+[A-Z_]+: \"(?<currentValue>[^\"]+)\""
      ]
    },
    {
      "customType": "regex",
      "description": "Second OpenTofu image of the validate matrix, equal to the opentofu pin of mise.toml (the first one is the supported minimum, bumped by hand)",
      "managerFilePatterns": [
        "/^\\.gitlab/release\\.yml$/"
      ],
      "matchStrings": [
        "TOFU_IMAGE_VERSION: \\[\"[0-9.]+\", \"(?<currentValue>[0-9.]+)\"\\]"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "ghcr.io/opentofu/opentofu"
    }
  ]
}
