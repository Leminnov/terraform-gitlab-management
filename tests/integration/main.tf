# Integration fixture (terraform-testing): applies the module to a sandbox
# group and project on a real GitLab. Run by run.sh, never by `tofu test`;
# names and keys carry a run suffix so leftovers of an aborted run never
# collide with the next one.
terraform {
  required_version = ">= 1.11.0"

  required_providers {
    gitlab = {
      source  = "gitlabhq/gitlab"
      version = "~> 19.5"
    }
  }

  # run.sh passes the state path, outside the repository.
  backend "local" {}
}

# Base URL and token from the environment (GITLAB_BASE_URL, GITLAB_TOKEN).
provider "gitlab" {}

variable "mode" {
  description = "owner: every resource type the owner token may create, and a group and project tree; least: the subset a Maintainer token may create (no group access token, a project runner instead of a group runner, no tree)."
  type        = string

  validation {
    condition     = contains(["owner", "least"], var.mode)
    error_message = "mode must be owner or least."
  }
}

variable "group_id" {
  description = "Numeric ID of the sandbox group (SANDBOX_GROUP_ID)."
  type        = string
}

variable "project_id" {
  description = "Numeric ID of the sandbox project in that group, with a main branch (SANDBOX_PROJECT_ID)."
  type        = string
}

variable "suffix" {
  description = "Run suffix appended to every name and key."
  type        = string
}

variable "expires_on" {
  description = "Token expiry date, YYYY-MM-DD, computed once by run.sh so the second plan sees the same value."
  type        = string
}

variable "deploy_key" {
  description = "OpenSSH public key generated by run.sh for the tree's deploy key (owner mode)."
  type        = string
  default     = null
}

variable "member_user_id" {
  description = "User ID of the owner token's user, read by run.sh, made a direct member of the tree's project (owner mode)."
  type        = number
  default     = null
}

variable "access_tokens" {
  description = "Create the group and project access tokens. run.sh sets false on a gitlab.com Free namespace, where they need Premium."
  type        = bool
  default     = true
}

variable "signing_token" {
  description = "Webhook signing token (whsec_ and the base64 of 32 random bytes), generated by run.sh, which checks it never appears in plan output."
  type        = string
  sensitive   = true
}

variable "sentinel" {
  description = "Throwaway secret value; run.sh checks it never appears in plan output."
  type        = string
  sensitive   = true
}

locals {
  key  = upper(replace(var.suffix, "-", "_"))
  tree = "it-${var.suffix}"

  # Throwaway tree: removed for good on destroy instead of archived.
  throwaway_group   = { archive_on_destroy = false, permanently_remove_on_delete = true }
  throwaway_project = { archive_on_destroy = false, permanently_delete_on_destroy = true }
}

module "gitlab_management" {
  source = "../.."

  # Creating subgroups needs the Owner role: the tree is built in owner mode only.
  parent_group_id = var.mode == "owner" ? tonumber(var.group_id) : null

  # A service account of the existing intermediate subgroup (the sandbox
  # group), invited into the tree. Top-level accounts are unit-tested only.
  service_accounts = {
    for k, v in {
      "it-${var.suffix}" = { group = var.group_id, tokens = { ci = { scopes = ["read_api"], expires_at = var.expires_on } } }
    } : k => v if var.mode == "owner"
  }

  groups = {
    for k, v in {
      (local.tree) = merge(local.throwaway_group, {
        members = { bot = { service_account = "it-${var.suffix}", access_level = "reporter" } }
      })
      "${local.tree}/team" = merge(local.throwaway_group, {
        service_accounts = { deployer = { tokens = { ci = { scopes = ["read_api"], rotation_configuration = { expiration_days = 30, rotate_before_days = 7 } } } } }
      })
      "${local.tree}/team/svc" = local.throwaway_group
    } : k => v if var.mode == "owner"
  }

  projects = {
    for k, v in {
      "${local.tree}/team/api" = merge(local.throwaway_project, {
        variables         = { IT_NESTED = { value = "nested" } }
        deploy_tokens     = { pull = { expires_at = "${var.expires_on}T00:00:00Z", scopes = ["read_repository"] } }
        deploy_keys       = { it = { key = var.deploy_key, expires_at = "${var.expires_on}T00:00:00Z" } }
        labels            = { bug = { color = "#d9534f" } }
        badges            = { pipeline = { link_url = "https://gitlab.com/%%{project_path}/-/pipelines", image_url = "https://gitlab.com/%%{project_path}/badges/%%{default_branch}/pipeline.svg" } }
        environments      = { production = { tier = "production" } }
        pipeline_triggers = [local.tree]
        hooks             = { it = { url = "https://example.com/${local.tree}", signing_token = var.signing_token } }
        shared_with       = { svc = { group = "${local.tree}/team/svc", access_level = "developer" } }
        # The owner token's user inherits Owner from the sandbox group, and
        # GitLab refuses a membership below an inherited one.
        members = {
          owner    = { user_id = var.member_user_id, access_level = "owner" }
          deployer = { service_account = "${local.tree}/team:deployer", access_level = "reporter" }
          release  = { service_account = "${local.tree}/team/api:release", access_level = "reporter" }
        }
        service_accounts    = { release = { tokens = { ci = { scopes = ["read_api"], expires_at = var.expires_on } } } }
        job_token_allowlist = { projects = ["${local.tree}/tools"] }
        ci                  = { hardening_enabled = true, delete_pipelines_in_seconds = 31536000 }
        freeze_periods      = { weekend = { freeze_start = "0 18 * * 5", freeze_end = "0 6 * * 1" } }
        secure_files        = { "it.txt" = var.sentinel }
        # Unlocked and paused: shared with tools, never picks a job.
        runners                        = { build = { tag_list = ["it-${var.suffix}"], paused = true } }
        package_protection_rules       = { npm = { package_type = "npm", package_name_pattern = "@it/*" } }
        container_protection_rules     = { all = { path_pattern = "*" } }
        container_tag_protection_rules = { release = { tag_name_pattern = "^v[0-9]+" } }
        # No .gitlab-ci.yml: commits must not start pipelines on the sandbox.
        files = {
          CODEOWNERS       = { content = "# Managed by the integration fixture\n" }
          "docs/README.md" = { content = "Seeded once\n", managed = false }
        }
        kubernetes_agents = { it = { ci_access = { groups = [local.tree] } } }
      })
      "${local.tree}/tools" = merge(local.throwaway_project, {
        enabled_runners             = ["${local.tree}/team/api:build"]
        enabled_deploy_keys         = ["${local.tree}/team/api:it"]
        container_expiration_policy = {}
      })
    } : k => v if var.mode == "owner"
  }

  group_variables = {
    secret = {
      key       = "IT_SECRET_${local.key}"
      groups    = [var.group_id]
      value     = var.sentinel
      protected = true
      masked    = true
    }
    plain = {
      key    = "IT_PLAIN_${local.key}"
      groups = [var.group_id]
      value  = "plain"
    }
  }

  project_variables = {
    file = {
      key           = "IT_FILE_${local.key}"
      projects      = [var.project_id]
      value         = "environment: integration\n"
      variable_type = "file"
    }
  }

  deploy_tokens = {
    registry = {
      groups     = [var.group_id]
      name       = "it-${var.suffix}"
      expires_at = "${var.expires_on}T00:00:00Z"
      scopes     = ["read_repository", "read_registry"]
    }
  }

  pipeline_schedules = {
    nightly = {
      project     = var.project_id
      description = "it-${var.suffix}"
      ref         = "refs/heads/main"
      cron        = "0 3 * * *"
      # Never triggers a pipeline in the sandbox.
      active = false
      variables = {
        IT_SCHEDULE_SECRET = var.sentinel
      }
    }
  }

  # A group runner needs the Owner role; the Maintainer run registers a project runner.
  gitlab_runners = {
    runner = {
      runner_type  = var.mode == "owner" ? "group_type" : "project_type"
      description  = "it-${var.suffix}"
      group_id     = var.mode == "owner" ? var.group_id : null
      project_id   = var.mode == "owner" ? null : var.project_id
      access_level = "ref_protected"
      tag_list     = ["it-${var.suffix}"]
      paused       = true
      untagged     = false
      locked       = var.mode != "owner"
    }
  }

  # Group access tokens need the Owner role; on gitlab.com, access tokens also
  # need Premium.
  gitlab_group_access_token = {
    for k, v in {
      bot = {
        groups       = [var.group_id]
        name         = "it-${var.suffix}"
        expires_at   = var.expires_on
        access_level = "reporter"
        scopes       = ["read_api"]
      }
    } : k => v if var.mode == "owner" && var.access_tokens
  }

  gitlab_project_access_token = {
    for k, v in {
      bot = {
        projects     = [var.project_id]
        name         = "it-${var.suffix}"
        expires_at   = var.expires_on
        access_level = "reporter"
        scopes       = ["read_api"]
      }
    } : k => v if var.access_tokens
  }
}

output "deploy_tokens" {
  description = "Deploy tokens of the run, read by run.sh"
  value       = module.gitlab_management.deploy_tokens
  sensitive   = true
}

output "project_access_tokens" {
  description = "Project access tokens of the run, read by run.sh"
  value       = module.gitlab_management.project_access_tokens
  sensitive   = true
}

output "group_access_tokens" {
  description = "Group access tokens of the run, read by run.sh"
  value       = module.gitlab_management.group_access_tokens
  sensitive   = true
}

output "gitlab_runner_tokens" {
  description = "Runner tokens of the run, read by run.sh"
  value       = module.gitlab_management.gitlab_runner_tokens
  sensitive   = true
}

output "pipeline_schedule_ids" {
  description = "Schedule IDs of the run, read by run.sh"
  value       = module.gitlab_management.pipeline_schedule_ids
}

output "groups" {
  description = "Groups of the tree, read by run.sh"
  value       = module.gitlab_management.groups
}

output "projects" {
  description = "Projects of the tree, read by run.sh"
  value       = module.gitlab_management.projects
}

output "pipeline_trigger_tokens" {
  description = "Pipeline trigger tokens of the tree, read by run.sh"
  value       = module.gitlab_management.pipeline_trigger_tokens
  sensitive   = true
}

output "service_account_tokens" {
  description = "Service account tokens of the run, read by run.sh"
  value       = module.gitlab_management.service_account_tokens
  sensitive   = true
}

output "kubernetes_agent_tokens" {
  description = "Kubernetes agent tokens of the run, read by run.sh"
  value       = module.gitlab_management.kubernetes_agent_tokens
  sensitive   = true
}

output "gitlab_runners" {
  description = "Runners of the run, read by run.sh"
  value       = module.gitlab_management.gitlab_runners
}

output "group_variables_ids" {
  description = "Group variable IDs of the run, read by run.sh"
  value       = module.gitlab_management.group_variables_ids
}
